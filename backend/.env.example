# Django
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Africa/Abidjan
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=
TOKEN_MAX_AGE=28800

# MySQL / WampServer
MYSQL_DATABASE=gestion_salles
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Frontend autorisé à appeler l'API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En développement, les e-mails sont affichés dans le terminal Django.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Service RH UNISERV BTP <rh@uniservci.net>

# À renseigner lors du passage au SMTP réel.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# Mailtrap Email Sandbox (tests uniquement, aucun email réel n'est livré)
# Pour l'activer, remplacez les valeurs EMAIL_* ci-dessus par celles-ci :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=identifiant-fourni-par-mailtrap
# EMAIL_HOST_PASSWORD=mot-de-passe-fourni-par-mailtrap
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Facultatif : utilisé par `python manage.py configurer_affichage`.
# Ne jamais committer le vrai mot de passe.
AFFICHAGE_PASSWORD=
SUPER_ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
