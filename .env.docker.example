# Configuration Docker de MaSalle.
# Copiez ce fichier en `.env` (à la racine du projet) puis remplissez les valeurs.
# Le fichier `.env` n'est jamais versionné : il contient des secrets.

# --- Base de données (créée automatiquement par Docker) ---
POSTGRES_DB=gestion_salles
POSTGRES_USER=masalle
POSTGRES_PASSWORD=CHANGEZ_MOI

# --- Application ---
# Générez une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGEZ_MOI
# Adresses par lesquelles on accède au site (séparées par des virgules).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Adresse publique du site, avec le port si besoin (utilisée dans les emails).
FRONTEND_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088
CSRF_TRUSTED_ORIGINS=http://localhost:8088

# Port du site sur votre ordinateur (8088 évite le conflit avec WAMP sur le 80).
WEB_PORT=8088

# --- Mode HTTP (test en local, sans HTTPS) ---
# En production avec HTTPS : supprimez ce bloc, et mettez DJANGO_BEHIND_PROXY=True
# si un serveur HTTPS (nginx, Caddy...) se trouve devant le site.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Emails ---
# `console` affiche les emails dans les journaux (test). Pour envoyer de vrais
# emails, utilisez le backend SMTP et renseignez votre serveur :
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=adresse@exemple.com
# EMAIL_HOST_PASSWORD=mot_de_passe
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=MaSalle UNISERV BTP <adresse@exemple.com>
